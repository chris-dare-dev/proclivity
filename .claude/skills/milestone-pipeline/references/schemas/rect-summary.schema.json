{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "milestone-pipeline/rect-summary",
  "title": "Rectification summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["milestone_id", "rect_commit_sha", "fixed", "deferred", "invalidated", "regression_tests_added"],
  "properties": {
    "milestone_id": { "type": "string" },
    "rect_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "rect_commit_subject": { "type": "string" },
    "fixed": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[CHML][0-9]+$" }
    },
    "deferred": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[CHML][0-9]+$" }
    },
    "invalidated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": {
            "type": "string",
            "enum": ["anchor-not-found", "code-no-longer-matches-claim", "superseded-by-other-fix"]
          }
        }
      }
    },
    "regression_tests_added": {
      "type": "array",
      "items": { "type": "string" }
    },
    "loop_iterations": {
      "type": "object",
      "properties": {
        "inner_max": { "type": "integer", "minimum": 0 },
        "outer": { "type": "integer", "minimum": 0 }
      }
    },
    "external_writes_required": { "type": "array", "items": { "type": "string" } },
    "external_writes_authorized": { "type": "array", "items": { "type": "string" } },
    "external_writes_completed": { "type": "array", "items": { "type": "string" } }
  }
}
