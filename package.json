{
  "name": "proclivity",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A personal new-tab Chrome extension for sprint/long-term todos, Gantt planning, and reminders.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.19.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.3"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "^2.80.0"
    }
  }
