{
  "name": "proclivity",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A personal new-tab Chrome extension for sprint/long-term todos, Gantt planning, and reminders.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ext": "npm run build && node scripts/print-load-path.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@react-three/fiber": "^8.18.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.3.2",
    "sonner": "^2.0.7",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.270",
    "@types/dom-chromium-ai": "^0.0.16",
    "@types/node": "^22.19.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "^2.80.0"
    }
  }
}
