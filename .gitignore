node_modules
dist
.DS_Store
*.log
.vite
.env
.env.local

# RSA private key backing the manifest `key` (stable extension ID).
# See plans/gemini-setup.md §1. The public half is committed in
# manifest.config.ts; the private half must never be.
*.pem

# tsc -b emit (composite project)
*.tsbuildinfo
vite.config.js
vite.config.d.ts
manifest.config.js
manifest.config.d.ts

# milestone-pipeline transient state — the lock + per-milestone state.json
# are rewritten on every invocation; only committed artifacts (research/*.md,
# critique/*.md, rectify/*.md, audit.jsonl, metrics.json) belong in git.
.claude/notes/milestones/.lock
.claude/notes/milestones/*/state.json
# git worktrees created by the Agent harness for delegated sub-agents
.claude/worktrees/
# roadmap + frontend-uplift transient state — same convention as milestones/*/state.json
.claude/notes/roadmaps/*/state.json
.claude/notes/frontend-uplifts/*/state.json
.claude/scheduled_tasks.lock
